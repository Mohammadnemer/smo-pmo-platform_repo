<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime;libs;contentfiles;analyzers;buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Rollup's cross-module reads only exist end to end with SMO and PMO also wired in
         (see RollupTestHost) — Api is referenced so the tests drive the real RBAC matrix
         and tenant middleware rather than a copy of them, same as Smo.Tests/Pmo.Tests. -->
    <ProjectReference Include="..\..\src\Api\Api.csproj" />
    <ProjectReference Include="..\..\src\Platform\Platform.csproj" />
    <ProjectReference Include="..\..\src\SMO\SMO.csproj" />
    <ProjectReference Include="..\..\src\PMO\PMO.csproj" />
    <ProjectReference Include="..\..\src\Rollup\Rollup.csproj" />
    <ProjectReference Include="..\..\src\Shared\Shared.csproj" />
    <!-- X2: the roll-up worker's debounce queue/processor live in /Worker, and the health
         test drives the real event -> queue -> processor -> mediator path rather than
         calling RecomputeDeliveryHealthCommand directly. -->
    <ProjectReference Include="..\..\src\Worker\Worker.csproj" />
  </ItemGroup>
</Project>
