<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SmoPmo.Pmo</RootNamespace>
    <AssemblyName>SmoPmo.Pmo</AssemblyName>
    <!-- Marks this as a bounded module: Directory.Build.targets forbids it from
         project-referencing anything but /Shared. -->
    <IsModule>true</IsModule>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- The PMO module owns its own tables, so it owns its own context, provider and
         migrations (docs/sessions/B6.md), the same move B5 made for SMO. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>
</Project>
