<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SmoPmo.Rollup</RootNamespace>
    <AssemblyName>SmoPmo.Rollup</AssemblyName>
    <!-- Marks this as a bounded module: Directory.Build.targets forbids it from
         project-referencing anything but /Shared. -->
    <IsModule>true</IsModule>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Roll-up module owns its own table, so it owns its own context, provider and
         migrations, the same as SMO (B5) and PMO (B6). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>
</Project>
